include ../../libremesh.mk

define Package/$(PKG_NAME)
  TITLE:=LibreMesh utils core
  CATEGORY:=LibreMesh
  MAINTAINER:=Samuele Longhi <agave@dracaena.it>
  URL:=https://libremesh.org
